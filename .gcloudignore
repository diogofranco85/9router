# Cloud Build upload ignore list.
# Prefer explicit rules so API routes under **/test/ and **/logs/ are included
# (a bare `test/*` / `logs/*` in .gitignore was excluding them from gcloud submit).

.gcloudignore
.git
.gitignore

# Dependencies and build output
node_modules/
.next/
.next-cli-build/
.next-analyze/
out/
build/
dist/
coverage/
cli/.build-home/

# Local env / secrets
.env
.env.*
!.env.example
!.env.gcp.example

# Runtime / local data
/data/
/logs/
/source/
.cursor/
.idea/
.vscode/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Prisma clients are generated in the Docker build
src/lib/db/generated/

# Heavy / unused for image build
tests/
open-sse/test/
open-sse.old/
gitbook/
gitbooks/
docs/
.claude/
.docs/
.repo/
.script/
.codegraph/
.PR/
.graphifyignore
graphify-out/
product/
.bin/
